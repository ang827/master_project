# Dependencies
**/node_modules/
**/.pnpm-store/

# Environment files and secrets (keep safe examples in version control)
.env
.env.*
!.env.example
!.env.*.example
**/key.properties
**/keystore.properties
**/*.jks
**/*.keystore
**/*.p12
**/*.pfx

# Python virtual environments, bytecode, and local databases
**/.venv/
**/venv/
**/__pycache__/
**/*.py[cod]
**/*.sqlite3
**/*.db-journal

# Frontend build output and local caches
**/dist/
**/dist-ssr/
**/coverage/
**/*.local
**/*.tsbuildinfo
**/.eslintcache

# Android / Gradle generated files
**/.gradle/
**/build/
**/local.properties
**/.externalNativeBuild/
**/.cxx/
**/*.apk
**/*.aab
**/*.aar
**/*.ap_
**/*.dex
**/*.class
**/*.hprof

# Logs and temporary files
**/*.log
**/npm-debug.log*
**/yarn-debug.log*
**/pnpm-debug.log*
**/*.tmp

# IDE and operating system files
**/.idea/
**/.vs/
**/*.iml
**/*.suo
.DS_Store
Thumbs.db
desktop.ini
